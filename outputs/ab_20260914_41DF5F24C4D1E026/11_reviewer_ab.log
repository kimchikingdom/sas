1349  +
1350  +data work.attack_detection_ci;
1351  +    set work.attack_detection;
1352  +    array hits[2] hits_text hits_kcbert;
1353  +    length model $20;
1354  +    do model_index=1 to 2;
1355  +        if model_index=1 then model='문자 n-gram';
1356  +        else model='KcBERT';
1357  +        detected=hits[model_index];
1358  +        detection_rate=detected/n;
1359  +        if detected=0 then lower_95=0;
1360  +        else lower_95=quantile('BETA',0.025,detected,n-detected+1);
1361  +        if detected=n then upper_95=1;
1362  +        else upper_95=quantile('BETA',0.975,detected+1,n-detected);
1363  +        output;
1364  +    end;
1365  +    keep attack_type model n detected detection_rate lower_95 upper_95;
1366  +    format detection_rate lower_95 upper_95 percent8.2;
1367  +run;

