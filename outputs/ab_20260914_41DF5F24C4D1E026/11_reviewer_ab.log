131          program = "&sas_file.";
132          status = "SKIPPED";
133          syscc = .;
134        run;
135      %end;
136      %else %do;
137        %let syscc=0;
138        %include "&file_path.";
139        %let cur_syscc=&syscc.;
140    
141        data work._tmp_status;
142          length step 8 stage_num $10 stage_name $45 program $35 status $15 syscc 8;
143          step = &step_idx.;
144          stage_num = "&stage_id.";
145          stage_name = "&stage_desc.";
146          program = "&sas_file.";
147          syscc = &cur_syscc.;
