656   +/* 2. 적합 및 수렴 상태. 부적절한 적합의 LR은 생성하지 않는다.
657   +   ParameterEstimates에서 Wald OR를 생성한다. 교호작용 계수의 exp(beta)는
658   +   조건부 OR 또는 OR의 비이며 유형 전체의 무조건 OR가 아니다.
659   +   LOG의 complete/quasi-complete separation·Hessian 경고도 확인한다. */
660   +%macro fit(tag=, data=dominant, class=, terms=, predict=0);
661   +    %global ok_&tag;
662   +    %let ok_&tag=0;
663   +    /* 같은 세션 재실행 실패 시 이전 ODS 결과를 새 결과로 읽지 않는다. */
664   +    proc datasets library=work nolist nowarn;
665   +        delete est_&tag fit_&tag conv_&tag joint_&tag or_&tag nobs_&tag;
666   +    quit;
667   +    proc logistic data=work.&data;
668   +        %if %length(%superq(class)) %then %do;
669   +            class &class / param=ref;
670   +        %end;
671   +        model detected(event='1') = &terms / clodds=wald maxiter=200;
672   +        ods output ParameterEstimates=work.est_&tag
673   +                   FitStatistics=work.fit_&tag
674   +                   ConvergenceStatus=work.conv_&tag
675   +                   NObs=work.nobs_&tag;
676   +        %if %length(%superq(class)) %then %do;
677   +            ods output &joint_table=work.joint_&tag;
678   +        %end;
679   +        %if &predict %then %do;
680   +            effectplot slicefit(x=similarity_to_train sliceby=attack_type_code) / clm;
681   +            output out=work.pred_inter predicted=phat;
682   +        %end;
683   +    run;
684   +    ods output close;
685   +    %if %sysfunc(exist(work.conv_&tag)) and %sysfunc(exist(work.est_&tag)) %then %do;
686   +        %local invalid_conv invalid_est n_conv n_est;
687   +        proc sql noprint;
688   +            select count(*) into :n_conv trimmed from work.conv_&tag;
689   +            select count(*) into :n_est trimmed from work.est_&tag;
690   +            select count(*) into :invalid_conv trimmed from work.conv_&tag
691   +            where missing(Status) or Status ne 0;
692   +            select count(*) into :invalid_est trimmed from work.est_&tag
693   +            where missing(Estimate) or missing(StdErr) or DF ne 1;
694   +        quit;
695   +        %if &n_conv>0 and &n_est>0 and &invalid_conv=0 and &invalid_est=0 %then %let ok_&tag=1;
696   +        data work.or_&tag;
697   +            set work.est_&tag;
698   +            odds_ratio=exp(Estimate);
699   +            or_ci_low=exp(Estimate-probit(0.975)*StdErr);
700   +            or_ci_high=exp(Estimate+probit(0.975)*StdErr);
701   +            inference_valid=&&ok_&tag;
702   +        run;
703   +        title "적합 상태 — &tag";
704   +        proc print data=work.conv_&tag noobs; run;
705   +        title "계수·Wald OR 및 95% CI — &tag";
706   +        proc print data=work.or_&tag noobs; run;
707   +    %end;
708   +    %if &&ok_&tag ne 1 %then %put WARNING: &tag 적합 검토 필요. 관련 LR 검정을 보류합니다.;
709   +%mend;
710   +
711   +/* 같은 행과 반응값의 사전 명시 중첩 모형끼리만 호출한다.
20                                                         SAS 시스템      2026년  9월 18일 금요일 오전 02시 10분 44초

712   +   추정 모수 수에서 df를 계산해 연도 개수를 상수로 가정하지 않는다. */
713   +%macro lr(reduced=, full=, out=);
714   +    proc datasets library=work nolist nowarn; delete &out; quit;
715   +    %if &&ok_&reduced=1 and &&ok_&full=1 %then %do;
716   +        %local p_small p_large;
717   +        proc sql noprint;
718   +            select sum(DF) into :p_small trimmed from work.est_&reduced;
719   +            select sum(DF) into :p_large trimmed from work.est_&full;
720   +        quit;
721   +        data work.&out;
722   +            merge work.fit_&reduced(where=(Criterion='-2 Log L')
723   +                       rename=(InterceptAndCovariates=reduced_m2ll))
724   +                  work.fit_&full(where=(Criterion='-2 Log L')
725   +                       rename=(InterceptAndCovariates=full_m2ll));
726   +            length comparison $80 analysis_status $32;
727   +            comparison="&reduced -> &full";
728   +            analysis_status='exploratory';
729   +            lr_statistic=reduced_m2ll-full_m2ll;
730   +            df=&p_large-&p_small;
731   +            if df>0 and not missing(lr_statistic) and lr_statistic>=-1e-7 then do;
732   +                lr_statistic=max(0,lr_statistic);
733   +                p_value=sdf('CHISQUARE',lr_statistic,df);
734   +            end;
735   +            else do;
736   +                analysis_status='invalid_likelihood_or_df';
737   +                p_value=.;
738   +            end;
739   +        run;
740   +        title "탐색적 우도비 검정 — &reduced -> &full";
741   +        proc print data=work.&out noobs;
742   +            var comparison reduced_m2ll full_m2ll lr_statistic df p_value analysis_status;
743   +        run;
744   +    %end;
745   +    %else %put WARNING: &out 보류. 관련 모형 수렴 및 분리를 먼저 확인하십시오.;
746   +%mend;
747   +
748   +/* 3. Sep 5의 가법모형·연도 × 유형 점검을 보존한다. AIC/p값은 적합 진단이며
749   +   이 표본으로 분류기나 정책을 선택하지 않는다. 비유의성으로 상쇄 부재를 증명하지
749  !+않는다. */
