1672  +%macro pick_fpr_threshold(indata, scorevar, outds);
1673  +    %local qualifying;
1674  +    %let qualifying=0;
1675  +    data work.fage_grid;
1676  +        set &indata.;
1677  +        do threshold_index = 0 to 1000;
1678  +            threshold = threshold_index / 1000;
1679  +            predicted = (&scorevar. >= threshold);
1680  +            output;
1681  +        end;
1682  +        threshold = 1.0001;
1683  +        predicted = (&scorevar. >= threshold);
1684  +        output;
1685  +    run;
1686  +    proc sql noprint;
1687  +        create table work.fage_threshold_stats as
1688  +        select threshold,
1689  +               sum(case when target=1 and predicted=1 then 1 else 0 end) as tp,
1690  +               sum(case when target=0 and predicted=1 then 1 else 0 end) as fp,
1691  +               sum(case when target=1 and predicted=0 then 1 else 0 end) as fn,
1692  +               sum(case when target=0 and predicted=0 then 1 else 0 end) as tn
1693  +        from work.fage_grid
1694  +        group by threshold;
1695  +        select count(*) into :qualifying trimmed
1696  +        from work.fage_threshold_stats
1697  +        where (fp + tn) > 0 and fp / (fp + tn) <= &fpr_ceiling.;
1698  +    quit;
1699  +    %if %sysevalf(&qualifying = 0, boolean) %then %do;
1700  +        %put ERROR: 보정에서 정상 오탐률 &fpr_ceiling. 이하 임계값이 없습니다.;
1701  +        %abort cancel;
1702  +    %end;
1703  +    data work.fage_threshold_stats;
1704  +        set work.fage_threshold_stats;
1705  +        recall = tp / max(tp + fn, 1);
1706  +        fpr = fp / max(fp + tn, 1);
1707  +    run;
1708  +    proc sort data=work.fage_threshold_stats;
1709  +        by descending recall fpr descending threshold;
1710  +    run;
1711  +    data &outds;
1712  +        set work.fage_threshold_stats;
1713  +        where fpr <= &fpr_ceiling.;
1714  +        output;
1715  +        stop;
1716  +    run;
1717  +%mend;
