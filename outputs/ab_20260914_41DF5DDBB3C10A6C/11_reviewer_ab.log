242   +  /* Both axes include all codes, including zero frequency rows and columns. */
243   +  data work.sc11_all_cells;
244   +    length measure $32;
245   +    set work.sc11_category_cells(in=category) work.sc11_action_cells(in=action);
246   +    if category then do; measure='category'; av=a_category; bv=b_category; end;
247   +    if action then do; measure=cats('action_',action_code); av=a_value; bv=b_value; end;
248   +    keep measure av bv n;
249   +  run;
250   +  proc sql;
251   +    create table work.sc11_margina as select measure,av,sum(n) as na
252   +      from work.sc11_all_cells group by measure,av;
253   +    create table work.sc11_marginb as select measure,bv,sum(n) as nb
254   +      from work.sc11_all_cells group by measure,bv;
255   +    create table work.sc11_chance as select a.measure,sum(a.na*b.nb) as numerator
256   +      from work.sc11_margina a inner join work.sc11_marginb b
257   +      on a.measure=b.measure and a.av=b.bv group by a.measure;
258   +    create table work.sc11_totals as select measure,sum(n) as n,
259   +      sum(case when av=bv then n else 0 end) as agree_n
260   +      from work.sc11_all_cells group by measure;
261   +    create table work.sc11_agreement as select t.*,c.numerator
262   +      from work.sc11_totals t inner join work.sc11_chance c on t.measure=c.measure;
263   +    create table work.sc11_action_set as select 'action_set' as measure length=32,
264   +      count(*) as n,sum(a_action_mask=b_action_mask) as agree_n from work.sc11_ab;
265   +  quit;
266   +  %sc11_check;
267   +  data work.sc11_agreement;
268   +    set work.sc11_agreement work.sc11_action_set;
269   +    agreement=.; kappa=.;
