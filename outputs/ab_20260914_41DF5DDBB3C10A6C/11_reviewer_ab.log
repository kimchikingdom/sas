233   +  proc sql;
234   +    create table work.sc11_action_cells as
235   +    select g.action_code,g.a_value,g.b_value,count(x.review_id) as n
236   +    from work.sc11_action_grid g left join work.sc11_actions x
237   +      on g.action_code=x.action_code and g.a_value=x.a_value and g.b_value=x.b_value
238   +    group by g.action_code,g.a_value,g.b_value order by g.action_code,g.a_value,g.b_value;
239   +  quit;
