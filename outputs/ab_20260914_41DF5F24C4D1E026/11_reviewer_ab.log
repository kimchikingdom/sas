869   +/*---------------------------------------------------------------------------
870   +  ScamLens 02 — 문자·URL 결합 메타 분류기 (PROC LOGISTIC)
871   +
872   +  Python의 scikit-learn 메타 분류기를 SAS로 다시 적합한다. 목적은 같은 계수를
873   +  얻는 것이 아니라 sklearn이 주지 않는 것을 얻는 것이다.
874   +
875   +    - 계수의 표준오차, Wald 검정, p-value
876   +    - 오즈비와 95% 신뢰구간
877   +    - 모형 적합도 검정
878   +
879   +  train에는 행 ID·그룹·폴드·입력/모델 해시를 검증한 OOF 확률만 사용한다.
880   +  저장 OOF가 없으면 고정된 기존 프로토콜로 train에서만 재생성할 수 있다.
881   +  이 경우 provenance는 reconstructed_fixed_protocol이며 과거 학습 당시 저장된
882   +  OOF 확률을 복구했다고 주장하지 않는다. OOF가 없거나 검증되지 않으면 중단한다.
883   +
884   +  이 적합은 무가중·무규제 최대우도 추론 모형이다. Python 채택 모형은
885   +  class_weight='balanced'인 규제 로지스틱이므로 같은 OOF 입력이어도 추정량이
886   +  다르다. SAS Wald 검정을 Python 채택 모형 계수의 p-value로 해석하지 않는다.
887   +  URL 두 변수의 공동 검정과 효과 크기·신뢰구간을 함께 보고한다.
888   +  비유의한 결과는 무기여나 동등성의 증명이 아니다.
889   +  표준 Wald 구간은 입력 점수를 고정한 조건부 탐색 결과이며 교차적합의 공유
890   +  모형·유사 문구 의존성 및 기준 모델 재학습 불확실성 전체를 반영하지 않는다.
891   +
892   +  임계값 정책은 Python과 동일하다. validation에서만 고르고 test는 1회 평가한다.
893   +
894   +  선행 조건: 01_load_and_audit.sas를 같은 세션에서 먼저 실행해야 한다.
895   +  work.scores가 없으면 여기서 멈춘다.
896   +---------------------------------------------------------------------------*/
897   +
898   +%let minimum_recall = 0.95;
899   +
900   +%macro require(dsname);
901   +    %if not %sysfunc(exist(&dsname.)) %then %do;
902   +        %put ERROR: &dsname. 이(가) 없습니다. 01_load_and_audit.sas를 먼저 실행하십시오.;
903   +        %abort cancel;
904   +    %end;
905   +%mend;
906   +%require(work.scores);
907   +%let sas_meta_fit_completed = 0;
908   +
