803   +/* Python과 같은 z=1.96 Wilson. 비율 0 또는 1에서도 유효한 경계를 낸다. */
804   +data work.stratified_ci;
805   +    set work.stratified;
806   +    z=1.96;
807   +    denom=1+z*z/rows;
808   +    centre=(detection_rate+z*z/(2*rows))/denom;
809   +    spread=z*sqrt(detection_rate*(1-detection_rate)/rows+z*z/(4*rows*rows))/denom;
810   +    ci_low=max(0,centre-spread);
811   +    ci_high=min(1,centre+spread);
812   +    misses=rows-detections;
813   +run;

