271   +      agreement=agree_n/n;
272   +      if measure ne 'action_set' then do;
273   +        pe=numerator/(n*n);
274   +        if pe<1 then kappa=(agreement-pe)/(1-pe);
275   +      end;
276   +    end;
277   +    format agreement kappa best32.;
