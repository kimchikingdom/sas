123    
124      %if not %sysfunc(fileexist(&file_path.)) %then %do;
125        %put WARNING: 실행 파일이 존재하지 않아 건너뜁니다: &file_path.;
126        data work._tmp_status;
127          length step 8 stage_num $10 stage_name $45 program $35 status $15 syscc 8;
128          step = &step_idx.;
129          stage_num = "&stage_id.";
130          stage_name = "&stage_desc.";
